# RTechLab Environment Configuration Template
# Set this to your production canonical origin without a trailing slash (e.g. https://rtechlab.com)
# When omitted, the app defaults to window.location.origin during browser runtime.
VITE_SITE_URL=https://rtechlab.com

# ----------------------------------------------------------------------------
# Lead capture (sample email gate + quiz results)
# JSON POST target. Free options: Formspree form URL, a Google Apps Script
# web app, or any serverless function. Empty = leads stay in localStorage only.
# ----------------------------------------------------------------------------
VITE_LEAD_ENDPOINT=

# ----------------------------------------------------------------------------
# UPI checkout (payment QR + app deep links)
# ----------------------------------------------------------------------------
VITE_UPI_VPA=
VITE_UPI_NAME=RTechLab
VITE_WHATSAPP=91XXXXXXXXXX

# ----------------------------------------------------------------------------
# YouTube Data API v3 Credentials (OAuth 2.0 Web / Desktop Application)
# Required for headless video upload, caption insertion, and future scheduling.
# Acquire these from Google Cloud Console > APIs & Services > Credentials.
# ----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_offline_refresh_token

# ----------------------------------------------------------------------------
# Gmail SMTP Configuration (Direct automated student delivery from your Gmail)
# Requires a 16-character Google App Password (myaccount.google.com/apppasswords)
# ----------------------------------------------------------------------------
GMAIL_USER=rahul.28e1@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password

# ----------------------------------------------------------------------------
# Resend Email API Configuration (Alternative / Fallback)
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="RTechLab Publishing <onboarding@resend.dev>"

# ----------------------------------------------------------------------------
# Meta Instagram Graph API Credentials (Professional Creator / Business Account)
# Required for Instagram Reels and Feed publishing.
# Acquire these from Meta for Developers (Graph API Explorer / System User).
# ----------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_or_user_access_token
INSTAGRAM_USER_ID=your_instagram_business_account_id

