{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RTechLabBookSchema",
  "type": "object",
  "required": [
    "book_id",
    "title",
    "edition",
    "authors",
    "target_audience",
    "chapters"
  ],
  "properties": {
    "book_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "edition": {
      "type": "string",
      "default": "2027 Industrial Edition"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_pages": {
      "type": "integer"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}