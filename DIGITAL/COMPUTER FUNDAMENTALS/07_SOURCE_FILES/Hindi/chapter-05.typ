== 5.8 7 प्राथमिक लॉजिक गेट्स: समीकरण एवं ट्रुथ टेबल सारांश
#table(
  columns: (1fr, 1.1fr, 1.3fr, 1.6fr),
  fill: (x, y) => if y == 0 { rtech-navy } else if calc.even(y) { rtech-paper } else { white },
  stroke: 0.3pt + rtech-border,
  inset: 3pt,
  table.header([*गेट का नाम*], [*बूलियन समीकरण*], [*ट्रुथ टेबल व्यवहार*], [*इलेक्ट्रॉनिक सर्किट व्यवहार एवं कार्य*]),
  [NOT (Inverter)], [$Y = overline(A)$], [इनपुट 0 $arrow.r$ आउटपुट 1; इनपुट 1 $arrow.r$ 0], [एकल-इनपुट गेट; इनपुट बिट को उल्टा (Invert) करता है।],
  [AND Gate], [$Y = A dot B$], [आउटपुट 1 केवल तभी जब #hl[दोनों इनपुट 1 हों]], [श्रृंखला (Series) स्विचिंग सर्किट; गुणात्मक लॉजिक।],
  [OR Gate], [$Y = A + B$], [आउटपुट 1 जब #hl[कम से कम कोई एक इनपुट 1 हो]], [समानांतर (Parallel) स्विचिंग सर्किट; योगात्मक लॉजिक।],
  [NAND Gate], [$Y = overline(A dot B)$], [आउटपुट 0 केवल तभी जब दोनों इनपुट 1 हों], [#hl[सार्वभौमिक गेट (Universal)]; AND का व्युत्क्रम।],
  [NOR Gate], [$Y = overline(A + B)$], [आउटपुट 1 केवल तभी जब दोनों इनपुट 0 हों], [#hl[सार्वभौमिक गेट (Universal)]; OR का व्युत्क्रम।],
  [XOR Gate], [$Y = A xor B$], [आउटपुट 1 जब इनपुट्स #hl[भिन्न (Odd 1s)] हों], [पैरिटी जनरेटर, बाइनरी हाफ-एडर्स में जोड़ हेतु प्रयुक्त।],
  [XNOR Gate], [$Y = overline(A xor B)$], [आउटपुट 1 जब इनपुट्स #hl[समान] हों], [डिजिटल कम्पेरेटर (समानता जांचक); XOR का व्युत्क्रम।]
)

