#faq-item(
  q: "पासवर्ड के मुकाबले पासकी (Passkey) का उपयोग करना इतना अधिक सुरक्षित क्यों माना जाता है?",
  a: "पारंपरिक पासवर्ड सर्वर के डेटाबेस में संग्रहित होता है, जहां से डेटा लीक होने पर करोड़ों पासवर्ड्स चोरी हो जाते हैं। पासकी में वेबसाइट के पास केवल आपकी पब्लिक की होती है और आपकी प्राइवेट की आपके डिवाइस के हार्डवेयर सिक्योर एन्क्लेव से कभी बाहर नहीं आती। इसके अलावा, पासकी वेबसाइट डोमेन से बंधी होती है, इसलिए फ़िशिंग वेबसाइट पर यह काम ही नहीं करती।"
)
#faq-item(
  q: "TPM 2.0 चिप क्या है और विंडोज 11 को इसकी अनिवार्यता क्यों है?",
  a: "ट्रस्टेड प्लेटफॉर्म मॉड्यूल (TPM) मदरबोर्ड पर एक समर्पित छेड़छाड़-रोधी हार्डवेयर सुरक्षा प्रोसेसर है। यह बिटलॉकर हार्ड ड्राइव एन्क्रिप्शन कुंजियों, पिन, और बायोमेट्रिक डेटा को सुरक्षित रखता है और यह सत्यापित करता है कि बूट प्रक्रिया में किसी रूटकिट ने कोई छेड़छाड़ तो नहीं की।"
)
#faq-item(
  q: "क्या पोस्ट-क्वांटम क्रिप्टोग्राफी (PQC) के लिए हमें नए क्वांटम कम्प्यूटर्स खरीदने पड़ेंगे?",
  a: "बिल्कुल नहीं! पोस्ट-क्वांटम एल्गोरिदम (जैसे FIPS 203 ML-KEM) ऐसे कठिन गणितीय लैटिस समीकरणों पर आधारित हैं जिन्हें साधारण पारंपरिक कम्प्यूटर्स और स्मार्टफोन्स पर आसानी से चलाया जा सकता है, लेकिन भविष्य के शक्तिशाली क्वांटम कम्प्यूटर्स भी उन्हें नहीं तोड़ पाएंगे।"
)

#v(1.5pt)

== 2. लघु-उत्तरीय समीक्षा प्रश्न एवं सत्यापित मॉडल उत्तर
#short-qa(
  num: 1,
  q: "सूचना सुरक्षा में CIA ट्रायड के तीन स्तंभों के नाम और उनका अर्थ लिखें।",
  a: "1. Confidentiality (केवल अधिकृत व्यक्ति डेटा देख सकें), 2. Integrity (डेटा में कोई अनाधिकृत छेड़छाड़ न हो), 3. Availability (आवश्यकता पड़ने पर सिस्टम हमेशा उपलब्ध रहे)।"
)
#short-qa(
  num: 2,
  q: "रूटकिट (Rootkit) अन्य सामान्य मैलवेयर की तुलना में अत्यधिक खतरनाक क्यों होता है?",
  a: "क्योंकि यह ऑपरेटिंग सिस्टम के कर्नेल (Ring 0) या मदरबोर्ड के UEFI बूटलोडर स्तर पर छिप जाता है और टास्क मैनेजर व सामान्य एंटीवायरस दोनों से अपनी प्रक्रिया को पूरी तरह अदृश्य कर लेता है।"
)
#short-qa(
  num: 3,
  q: "NIST द्वारा आधिकारिक तौर पर जारी किए गए प्राथमिक PQC एन्क्रिप्शन मानक का क्या नाम है?",
  a: "NIST FIPS 203 (ML-KEM — मॉड्यूल लैटिस की-इनकैप्सुलेशन मैकेनिज्म)।"
)
#short-qa(
  num: 4,
  q: "ज़ीरो ट्रस्ट सुरक्षा मॉडल का मूल मार्गदर्शक सिद्धांत क्या है?",
  a: "'Never Trust, Always Verify' (कभी भी डिफ़ॉल्ट रूप से भरोसा न करें, प्रत्येक नेटवर्क और उपयोगकर्ता अनुरोध को हमेशा स्पष्ट रूप से सत्यापित करें)।"
)

#v(1.5pt)

== 3. 5 उच्च-महत्वपूर्ण बहुविकल्पीय प्रश्न (High-Yield MCQs)
#mcq(num: 1, q: "सिमेट्रिक एन्क्रिप्शन में डेटा को एन्क्रिप्ट और डिक्रिप्ट करने के लिए कितनी कुंजियों का उपयोग किया जाता है?", a: "दो भिन्न कुंजियाँ", b: "केवल एक साझा गुप्त कुंजी", c: "चार कुंजियाँ", d: "शून्य कुंजी", ans: "B", expl: "सिमेट्रिक एन्क्रिप्शन (जैसे AES-256) में प्रेषक और प्राप्तकर्ता दोनों एक ही गुप्त कुंजी साझा करते हैं।")
#mcq(num: 2, q: "कंप्यूटिंग में पासवर्ड-विहीन प्रमाणीकरण हेतु प्रयुक्त आधुनिक वैश्विक मानक कौन सा है?", a: "FIDO2 / WebAuthn", b: "FTP", c: "POP3", d: "Telnet", ans: "A", expl: "FIDO2 और WebAuthn असिमेट्रिक क्रिप्टोग्राफी और बायोमेट्रिक्स का उपयोग करके सुरक्षित पासकीज प्रदान करते हैं।")
#mcq(num: 3, q: "पीड़ित के कम्प्यूटर की सभी महत्वपूर्ण फाइलों को एन्क्रिप्ट करके फिरौती मांगने वाले मैलवेयर को क्या कहते हैं?", a: "स्पायवेयर", b: "रैनसमवेयर (Ransomware)", c: "ऐडवेयर", d: "वर्म", ans: "B", expl: "रैनसमवेयर फाइलों को मजबूत एन्क्रिप्शन से लॉक कर देता है और उन्हें खोलने हेतु डिजिटल फिरौती मांगता है।")
#mcq(num: 4, q: "UEFI सिक्योर बूट का प्राथमिक उद्देश्य क्या है?", a: "विंडोज को तेज शटडाउन करना", b: "केवल डिजिटल रूप से हस्ताक्षरित वैध बूटलोडर को चलने देना", c: "इंटरनेट स्पीड बढ़ाना", d: "डिस्क डीफ्रैगमेंट करना", ans: "B", expl: "सिक्योर बूट OEM कुंजियों से सत्यापित बूटलोडर को ही चलने देता है ताकि रूटकिट्स लोड न हो सकें।")
#mcq(num: 5, q: "NIST FIPS 204 मानक किस उद्देश्य हेतु आधिकारिक पोस्ट-क्वांटम एल्गोरिदम है?", a: "सिमेट्रिक ब्लॉक सिफर", b: "डिजिटल सिग्नेचर (ML-DSA)", c: "हार्ड डिस्क विभाजन", d: "ऑडियो कम्प्रेशन", ans: "B", expl: "FIPS 204 (ML-DSA) डिजिटल हस्ताक्षरों और कोड सत्यापन हेतु प्राथमिक वैश्विक PQC मानक है।")

