== 6.3 4-चरणीय C/C++ कम्पाइलेशन एवं बिल्ड पाइपलाइन
#table(
  columns: (0.8fr, 1.2fr, 1.5fr, 1.5fr),
  fill: (x, y) => if y == 0 { rgb("#E2E8F0") } else if calc.even(y) { rtech-paper } else { white },
  stroke: 0.3pt + rtech-border,
  inset: 3pt,
  table.header([*स्टेज*], [*पाइपलाइन चरण*], [*कमांड / आंतरिक टूल*], [*आउटपुट फाइल एवं कार्य*]),
  [1], [प्री-प्रोसेसिंग (Preprocessing)], [`gcc -E main.c -o main.i`], [हेडर फाइल्स (`#include`) का विस्तार, मैक्रोज़ (`#define`) का प्रतिस्थापन, टिप्पणियां हटाना।],
  [2], [कम्पाइलेशन (Compilation)], [`gcc -S main.i -o main.s`], [C सिंटैक्स पार्सिंग, इंटरमीडिएट ऑप्टिमाइजेशन, x86-64 असेंबली कोड (`main.s`) उत्पन्न करना।],
  [3], [असेंबली (Assembly)], [`as main.s -o main.o`], [असेंबली निर्देशों को बाइनरी मशीन कोड रिलोकेटेबल ऑब्जेक्ट फाइल (`main.o`) में बदलना।],
  [4], [लिंकिंग (Linking)], [`ld main.o -lc -o app.exe`], [ऑब्जेक्ट फाइल्स को C स्टैंडर्ड लाइब्रेरी (`libc`) से जोड़कर निष्पादन योग्य बाइनरी (`app.exe`) बनाना।]
)

