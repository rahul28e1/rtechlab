== 4.2 विशेष प्रयोजन CPU रजिस्टर्स (Special-Purpose Registers)
#table(
  columns: (1fr, 1.2fr, 2.8fr),
  fill: (x, y) => if y == 0 { rgb("#E2E8F0") } else if calc.even(y) { rtech-paper } else { white },
