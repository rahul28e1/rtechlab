  [PC], [प्रोग्राम काउंटर (Program Counter)], [मेमोरी में निष्पादित होने वाले #hl[अगले निर्देश का मेमोरी एड्रेस] रखता है। प्रत्येक निर्देश के बाद स्वतः बढ़ जाता है।],
  [IR], [निर्देश रजिस्टर (Instruction Register)], [वर्तमान में डिकोड और निष्पादित हो रहे बाइनरी मशीन निर्देश के ऑपकोड को थामे रखता है।],
  [MAR], [मेमोरी एड्रेस रजिस्टर (MAR)], [उस मेमोरी लोकेशन का भौतिक पता रखता है जिसे CPU पढ़ना (Read) या लिखना (Write) चाहता है; एड्रेस बस से जुड़ा होता है।],
  [MDR / MBR], [मेमोरी डेटा रजिस्टर (MDR)], [मेमोरी से पढ़ा गया या मेमोरी में लिखा जाने वाला वास्तविक 64-बिट डेटा थामता है; सीधे डेटा बस से जुड़ा होता है।],
  [AC / RAX], [एक्युमुलेटर (Accumulator)], [ALU द्वारा निष्पादित अंकगणितीय व तार्किक गणनाओं के तात्कालिक मध्यवर्ती परिणामों को तुरंत सहेजता है।],
  [FLAGS / RFLAGS], [स्टेटस / फ्लैग्स रजिस्टर], [शून्य परिणाम (Zero Flag), कैरी (Carry), ओवरफ्लो (Overflow), साइन (Negative) और पैरिटी जैसी स्थितियों को बिट्स में दर्शाता है।]
)

