#interview-q(num: 1, q: "VLOOKUP तथा XLOOKUP के बीच मुख्य तकनीकी अंतर क्या है?", ans: "VLOOKUP केवल बाएं से दाएं देखता है, नई कॉलम जोड़ने पर टूट जाता है, तथा डिफ़ॉल्ट रूप से अनुमानित खोज करता है। XLOOKUP दोनों दिशाओं में खोजता है, सुरक्षित रहता है, सटीक मिलान करता है, तथा खाली डेटा को स्वतः संभालता है।")

#interview-q(num: 2, q: "आधुनिक एक्सेल में स्पिल (Spill) तंत्र तथा #SPILL! त्रुटि क्या है?", ans: "डायनामिक एरे फॉर्मूले स्वतः पास के खाली सेल्स में फैल जाते हैं। यदि इस फैलाव क्षेत्र के बीच में कोई भी रुकावट (डेटा, मर्ज सेल) आ जाए, तो एक्सेल रुक जाता है और #SPILL! त्रुटि प्रदर्शित करता है।")

#interview-q(num: 3, q: "=COUNT, =COUNTA तथा =COUNTBLANK के बीच क्या अंतर है?", ans: "=COUNT केवल संख्या वाले सेल्स गिनता है। =COUNTA सभी भरे हुए सेल्स (संख्या, टेक्स्ट, त्रुटि) गिनता है। =COUNTBLANK केवल पूरी तरह खाली सेल्स की गणना करता है।")

#interview-q(num: 4, q: "पुराने सिस्टम्स में VLOOKUP के स्थान पर INDEX/MATCH क्यों चुनना चाहिए?", ans: "INDEX/MATCH स्वतंत्र कॉलम रेंजेस का उपयोग करता है, कंप्यूटर की मेमोरी बहुत कम खर्च करता है, बाईं ओर की खोज कर सकता है, तथा नई कॉलम जोड़ने पर कभी नहीं टूटता।")

#interview-q(num: 5, q: "पावर क्वेरी (Power Query) मासिक ETL डेटा रिफ्रेश को कैसे स्वचालित करती है?", ans: "पावर क्वेरी डेटा लोड और सफाई के सभी चरणों को M भाषा में रिकॉर्ड कर लेती है। जब भी नया डेटा आता है, 'Refresh All' दबाते ही सारे चरण सेकंडों में स्वतः दोबारा निष्पादित हो जाते हैं।")

#interview-q(num: 6, q: "पिवट कैश (Pivot Cache) क्या है और यह फाइल के आकार को कैसे प्रभावित करता है?", ans: "पिवट टेबल बनाते समय एक्सेल मूल डेटा का एक आंतरिक स्नैपशॉट मेमोरी में सुरक्षित रखता है जिसे पिवट कैश कहते हैं। कई टेबल्स एक ही कैश साझा करें तो फाइल हल्की रहती है, अलग-अलग कैश बनाने से फाइल भारी हो जाती है।")

#interview-q(num: 7, q: "पिवट टेबल में Calculated Field और Calculated Item में क्या अंतर है?", ans: "Calculated Field मौजूदा फील्ड्स पर गणना करके नई कॉलम बनाता है (जैसे =Sales * 18%)। Calculated Item किसी एक फील्ड के अलग-अलग मदों के बीच गणित करके नई पंक्ति बनाता है।")

#interview-q(num: 8, q: "लंबे वर्ड डॉक्यूमेंट में स्टाइल्स (Styles) की क्या भूमिका होती है?", ans: "Heading 1-9 स्टाइल्स दस्तावेज में पदानुक्रम बनाती हैं। इन्हीं के आधार पर स्वचालित अनुक्रमणिका (TOC), नेविगेशन ट्री तथा एक क्लिक में पूरे दस्तावेज का फॉन्ट बदलना संभव होता है।")

#interview-q(num: 9, q: "वर्ड में Section Break (Next Page) और Page Break में क्या अंतर है?", ans: "Page Break केवल टेक्स्ट को अगले पेज पर भेजता है। Section Break स्वतंत्र भाग बनाता है, जिससे अलग हेडर/फुटर, नए सिरे से पेज नंबर तथा लैंडस्केप/पोर्ट्रेट लेआउट संभव होता है।")

#interview-q(num: 10, q: "मेल मर्ज में संख्यात्मक फॉर्मेटिंग (जैसे ₹50000 का 50000.0000001 दिखना) कैसे ठीक करें?", ans: "Alt + F9 दबाकर फील्ड कोड खोलें और पिक्चर स्विच जोड़ें: { MERGEFIELD Salary \\# \"#,##,##0.00\" }।")

#interview-q(num: 11, q: "पावरपॉइंट में पैरेंट स्लाइड मास्टर और चाइल्ड लेआउट में क्या अंतर है?", ans: "पैरेंट मास्टर का फॉन्ट, रंग व लोगो सभी स्लाइड्स पर लागू होता है। चाइल्ड लेआउट केवल उसी खास लेआउट वाली स्लाइड्स पर लागू होता है।")

#interview-q(num: 12, q: "मॉर्फ (Morph) ट्रांजिशन सामान्य एनिमेशन से कैसे भिन्न है?", ans: "सामान्य एनिमेशन में हाथ से पाथ बनाना पड़ता है। मॉर्फ दो अलग स्लाइड्स के बीच वस्तुओं के स्थान व आकार के अंतर को स्वतः मापकर 60fps की सहज गति प्रदान करता है।")

#interview-q(num: 13, q: "पावरपॉइंट मॉर्फ में दो बार विस्मयादिबोधक (!!) का क्या उपयोग है?", ans: "सिलेक्शन पेन में नाम के आगे !! (जैसे !!HeroShape) लगाने से दो बिल्कुल भिन्न आकृतियां भी आपस में एक-दूसरे में मॉर्फ हो जाती हैं।")

#interview-q(num: 14, q: "वनड्राइव का डिफरेंशियल डेल्टा सिंक नेटवर्क को कैसे गति प्रदान करता है?", ans: "पूरी फाइल दोबारा अपलोड करने के बजाय यह केवल बदले हुए कुछ बाइट्स अपलोड करता है, जिससे इंटरनेट डेटा खपत में 95% से अधिक कमी आती है।")

#interview-q(num: 15, q: "ऑफिस 365 फाइल शेयर करते समय 'Block Download' चुनने से क्या होता है?", ans: "प्राप्तकर्ता केवल वेब ब्राउज़र में फाइल पढ़ सकता है; फाइल को डाउनलोड करना, प्रिंट करना या टेक्स्ट कॉपी करना पूरी तरह ब्लॉक रहता है।")

