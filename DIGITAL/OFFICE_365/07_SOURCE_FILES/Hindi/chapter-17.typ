  [`FIND`], [Case-Sensitive], [अक्षरशः मिलान: `=FIND("P", "Rahul Patel")` 7 देगा। `=FIND("p", ...)` एरर देगा।], [नहीं],
  [`SEARCH`], [Case-Insensitive], [उदार मिलान: `=SEARCH("patel", "Rahul Patel")` बिना एरर के 7 लौटाएगा।], [हाँ (`*`, `?`)]
