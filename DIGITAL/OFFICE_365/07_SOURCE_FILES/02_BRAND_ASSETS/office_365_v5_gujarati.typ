        [
          #text(size: 7pt, weight: "bold", fill: rgb("#107C41"))[Word · Excel · PowerPoint · Outlook · Cloud]
          #text(size: 7pt, fill: rgb("#64748B"))[ · Rahul Patel]
        ]
      )
      #v(1pt)
      #line(length: 100%, stroke: 0.5pt + rgb("#CBD5E1"))
    ]
  },
  footer: context {
    let p = counter(page).get().first()
    if p > 1 [
      #line(length: 100%, stroke: 0.5pt + rgb("#CBD5E1"))
      #v(1pt)
      #grid(columns: (1fr, auto), align: (left + horizon, right + horizon),
        [#text(size: 6.4pt, fill: rgb("#64748B"))[#text(fill: rgb("#0284C7"))[●] 150 Production Shortcuts · Free Tools: #link("https://rtechlab.com/tools")[*rtechlab.com/tools*] · Technology Made Practical]],
