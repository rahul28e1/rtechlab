  [`=LEFT(text, [અક્ષર_સંખ્યા])`], [બિલ્કુલ બાઈં ઓર થી અક્ષર નિકાલતા છે.], [`=LEFT(A2, 3)` નો ઉત્તર `"RTL"` (કંપની કોડ) હશે.],
  [`=RIGHT(text, [અક્ષર_સંખ્યા])`], [બિલ્કુલ દાઈં ઓર થી અક્ષર નિકાલતા છે.], [`=RIGHT(A2, 4)` નો ઉત્તર `"2027"` (વર્ષ) હશે.],
