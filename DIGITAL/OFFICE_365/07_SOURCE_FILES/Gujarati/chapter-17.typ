પરિવર્તનશીલ લંબાઈ વાળા ટેક્સ્ટ (જેમ કે અલગ-અલગ લંબાઈ ના પ્રથમ નામ) માં થી શબ્દ અલગ કરવા માટે સ્પેસ નો સ્થાન ખોજના પડતા છે:

#table(
  columns: (1fr, 1.3fr, 2.7fr, 1fr),
  fill: (x, y) => if y == 0 { rgb("#E2E8F0") } else if calc.even(y) { rgb("#F8FAFC") } else { white },
  stroke: 0.5pt + rgb("#64748B"),
  inset: (x: 3pt, y: 2pt),
