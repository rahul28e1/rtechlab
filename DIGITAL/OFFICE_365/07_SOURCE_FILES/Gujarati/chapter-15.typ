  [`AND`], [કેવલ ત્યારે `TRUE` આપે છે જ્યારે *બધા* શર્તેં સત્ય હોં.], [`=IF(AND(ઉપસ્થિતિ>=0.85, અંક>=75), "સમ્માન", "સામાન્ય")`],
  [`OR`], [જો *કોઈ એક ભી* શર્ત સત્ય હો તો `TRUE` આપે છે.], [`=IF(OR(અનુભવ>=5, પ્રમાણન="CCNA"), "ચયનિત", "અસ્વીકૃત")`],
  [`NOT`], [બૂલિયન સ્થિતિ ને ઉલટ આપે છે (`TRUE` ને `FALSE` માં).], [`=IF(NOT(ક્રેડિટ_રેટિંગ="ડિફ઼ૉલ્ટ"), "ઋણ સ્વીકૃત", "અસ્વીકૃત")`]
)

#concept-box(title: "અત્યંત મહત્વપૂર્ણ સિંટૈક્સ નિયમ: IF ના ભીતર AND નો પ્રયોગ", [
  એક્સેલ માં `=IF(A1 > 50 AND B1 > 50, ...)` કભી ન લિખેં—આ અવૈધ છે! એક્સેલ માં `AND` અને `OR` ફંક્શન થાય છે જો અપને તર્કોં થી પહલે આતે છે: `=IF(AND(A1>50, B1>50), ...)`.
])

