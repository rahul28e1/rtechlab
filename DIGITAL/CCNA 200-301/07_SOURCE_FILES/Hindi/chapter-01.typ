#text(size: 7.5pt, weight: "bold", fill: rtech-navy)[2. लघु-उत्तरीय समीक्षा प्रश्न]
#short-q(num: 1, q: "सिस्को हायरार्किकल मॉडल की तीन कार्यात्मक लेयर्स के नाम बताएं।", ans: "कोर लेयर, डिस्ट्रीब्यूशन लेयर, एवं एक्सेस लेयर।")
#short-q(num: 2, q: "8 नोड्स वाली फुल-मेश टोपोलॉजी में कितने फिजिकल लिंक की आवश्यकता होगी?", ans: "28 फिजिकल लिंक (फॉर्मूला: N(N-1)/2 = 8*7/2 = 28)।")
#short-q(num: 3, q: "आधुनिक क्लाउड और वर्चुअलाइज्ड डेटा सेंटरों में कौन सा ट्रैफिक पैटर्न हावी है?", ans: "ईस्ट-वेस्ट ट्रैफिक (सर्वर-टू-सर्वर संचार)।")
#short-q(num: 4, q: "कौन सी नेटवर्क लेयर 802.1X पोर्ट सुरक्षा और PoE लागू करती है?", ans: "एक्सेस लेयर (Access Layer)।")

#v(1pt)
#text(size: 7.5pt, weight: "bold", fill: rtech-navy)[3. 5 उच्च-प्राथमिकता बहुविकल्पीय प्रश्न (MCQs)]
#mcq(num: 1, q: "सिस्को 3-टियर मॉडल में कौन सा टियर रूटिंग पॉलिसी, VLAN टर्मिनेशन और ACL सुरक्षा लागू करने के लिए जिम्मेदार है?", a: "कोर लेयर", b: "डिस्ट्रीब्यूशन लेयर", c: "एक्सेस लेयर", d: "फिजिकल लेयर", ans: "B", expl: "डिस्ट्रीब्यूशन लेयर एक्सेस स्विचों को जोड़ती है और सुरक्षा नीतियों, इंटर-VLAN रूटिंग तथा QoS को लागू करती है।")
#mcq(num: 2, q: "स्पाइन-लीफ डेटा सेंटर फैब्रिक में कौन सा कनेक्शन सख्त वर्जित है?", a: "लीफ से सर्वर", b: "लीफ से स्पाइन", c: "स्पाइन से स्पाइन", d: "लीफ से स्टोरेज ऐरे", ans: "C", expl: "स्पाइन-लीफ क्लॉस आर्किटेक्चर में स्पाइन कभी दूसरे स्पाइन से और लीफ कभी दूसरे लीफ से सीधे नहीं जुड़ते।")
#mcq(num: 3, q: "2-टियर कोलैप्स्ड कोर आर्किटेक्चर का मुख्य लाभ क्या है?", a: "Layer 3 रूटिंग की आवश्यकता समाप्त करता है", b: "रिडंडेंसी बनाए रखते हुए लागत, केबलिंग और हार्डवेयर पदचिह्न घटाता है", c: "अनंत स्केलेबिलिटी प्रदान करता है", d: "ईथरनेट को इन्फिनिबैंड से बदलता है", ans: "B", expl: "कोलैप्स्ड कोर छोटे नेटवर्कों के लिए कोर और डिस्ट्रीब्यूशन को मिलाकर लागत और जटिलता कम करता है।")
#mcq(num: 4, q: "स्पाइन-लीफ नेटवर्क में किन्हीं दो सर्वरों के बीच कितने नेटवर्क हॉप्स होते हैं?", a: "1 हॉप", b: "ठीक 2 हॉप्स", c: "3 से 5 हॉप्स", d: "MTU पर निर्भर", ans: "B", expl: "ट्रैफिक सोर्स लीफ से स्पाइन और फिर डेस्टिनेशन लीफ पर जाता है, जिससे निश्चित 2-हॉप लेटेंसी मिलती है।")
#mcq(num: 5, q: "कौन सी तकनीक कंट्रोल प्लेन को हार्डवेयर से अलग कर ब्रॉडबैंड और MPLS पर डायनामिक रूटिंग करती है?", a: "फ्रेम रिले", b: "ATM", c: "SD-WAN", d: "डायल-अप ISDN", ans: "C", expl: "सॉफ्टवेयर-डिफाइंड WAN (SD-WAN) लिंक गुणवत्ता के आधार पर ट्रैफिक को गतिशील रूप से रूट करता है।")

