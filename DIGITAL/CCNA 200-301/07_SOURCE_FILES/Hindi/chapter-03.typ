#text(size: 7.5pt, weight: "bold", fill: rtech-navy)[3. 5 उच्च-प्राथमिकता बहुविकल्पीय प्रश्न (MCQs)]
#mcq(num: 1, q: "कौन सा सबनेट मास्क न्यूनतम पते बर्बाद करते हुए कम से कम 50 उपयोगी होस्ट आईपी पते प्रदान करता है?", a: "255.255.255.128 (/25)", b: "255.255.255.192 (/26)", c: "255.255.255.224 (/27)", d: "255.255.255.240 (/28)", ans: "B", expl: "/26 मास्क 2^6 - 2 = 62 उपयोगी होस्ट देता है, जो 50 की जरूरत को न्यूनतम बर्बादी के साथ पूरा करता है। /27 केवल 30 होस्ट देता है।")
#mcq(num: 2, q: "होस्ट 192.168.1.135 (सबनेट मास्क 255.255.255.224) का ब्रॉडकास्ट एड्रेस क्या है?", a: "192.168.1.143", b: "192.168.1.159", c: "192.168.1.191", d: "192.168.1.255", ans: "B", expl: "ब्लॉक साइज 32 (256-224) है। सबनेट 0, 32, 64, 96, 128, 160 हैं। 135 सबनेट 128 में आता है। ब्रॉडकास्ट 159 है।")
#mcq(num: 3, q: "कौन सा एक वैध RFC 1918 प्राइवेट IPv4 एड्रेस है?", a: "172.32.10.1", b: "192.169.1.5", c: "172.25.100.50", d: "11.0.0.1", ans: "C", expl: "क्लास B प्राइवेट रेंज 172.16.0.0 से 172.31.255.255 तक होती है। 172.25.100.50 इसी रेंज में आता है।")
#mcq(num: 4, q: "VLSM करते समय आवंटन का पहला नियम क्या है?", a: "पहले पॉइंट-टू-पॉइंट लिंक आवंटित करें", b: "विभागों को सबसे बड़ी होस्ट आवश्यकता से सबसे छोटी में क्रमबद्ध करें", c: "सभी को /24 मास्क दें", d: "हेक्साडेसिमल में बदलें", ans: "B", expl: "VLSM में एड्रेस फ्रैग्मेंटेशन और ओवरलैपिंग रोकने के लिए सबसे बड़े सबनेट पहले आवंटित करने चाहिए।")
#mcq(num: 5, q: "पैकेट अग्रेषित करते समय राउटर द्वारा बिटवाइज़ बूलियन AND ऑपरेशन का उद्देश्य क्या है?", a: "चेकसम गणना करना", b: "यह तय करना कि गंतव्य आईपी स्थानीय सबनेट पर है या डिफॉल्ट गेटवे चाहिए", c: "पेलोड एन्क्रिप्ट करना", d: "स्पीड तय करना", ans: "B", expl: "राउटर गंतव्य आईपी को सबनेट मास्क के साथ AND करता है ताकि रूटिंग टेबल में नेटवर्क आईडी खोजी जा सके।")

