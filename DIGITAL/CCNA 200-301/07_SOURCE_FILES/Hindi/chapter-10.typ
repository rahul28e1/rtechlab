== 10.8 वाइवा वन-लाइनर्स (भाग 2: 16–30) एवं परीक्षा रणनीति
#short-qa(num: 16, q: "IPv6 लूपबैक एड्रेस क्या है?", a: "::1/128।")
#short-qa(num: 17, q: "APIPA एड्रेस 169.254.x.x क्या दर्शाता है?", a: "कंप्यूटर DHCP सर्वर तक पहुंचने में विफल रहा।")
#short-qa(num: 18, q: "कौन सा पोर्ट सिक्योरिटी मोड उल्लंघन होने पर पोर्ट को err-disabled में डालता है?", a: "Shutdown मोड।")
#short-qa(num: 19, q: "सिस्को स्विच CAM टेबल का डिफ़ॉल्ट एजिंग समय क्या है?", a: "300 सेकंड (5 मिनट)।")
#short-qa(num: 20, q: "SSH के लिए 2048-बिट RSA की जनरेट करने वाली कमांड क्या है?", a: "crypto key generate rsa modulus 2048।")
#short-qa(num: 21, q: "ईथरनेट पर OSPF का डिफ़ॉल्ट हैलो और डेड इंटरवल क्या है?", a: "हैलो 10 सेकंड, डेड 40 सेकंड।")
#short-qa(num: 22, q: "इंटरफेस स्थिति और आईपी संक्षेप में दिखाने वाली कमांड क्या है?", a: "show ip interface brief।")
#short-qa(num: 23, q: "'no ip domain-lookup' कमांड क्या रोकती है?", a: "गलत कमांड टाइप होने पर 30-सेकंड की CLI रुकावट।")
#short-qa(num: 24, q: "सबनेट मास्क 255.255.255.252 (/30) के लिए वाइल्डकार्ड क्या है?", a: "0.0.0.3।")
#short-qa(num: 25, q: "HSRP वर्जन 1 का वर्चुअल MAC प्रीफिक्स क्या है?", a: "0000.0c07.acXX।")
#short-qa(num: 26, q: "सुरक्षित रिमोट लॉगिन के लिए टेलनेट को कौन सा प्रोटोकॉल बदलता है?", a: "SSH वर्जन 2 (TCP पोर्ट 22)।")
#short-qa(num: 27, q: "PortFast पोर्ट पर BPDU आने पर BPDU Guard क्या करता है?", a: "पोर्ट को तुरंत err-disabled में बंद कर देता है।")
#short-qa(num: 28, q: "10.0.0.1 की ओर डिफॉल्ट स्टैटिक रूट बनाने की कमांड क्या है?", a: "ip route 0.0.0.0 0.0.0.0 10.0.0.1।")
#short-qa(num: 29, q: "4-चरणीय DHCP प्रक्रिया का पहला चरण क्या है?", a: "क्लाइंट द्वारा DHCPDISCOVER ब्रॉडकास्ट।")
#short-qa(num: 30, q: "OSPF में डिफ़ॉल्ट रेफरेंस बैंडविड्थ क्या है?", a: "100 Mbps (10^8 bps)।")

