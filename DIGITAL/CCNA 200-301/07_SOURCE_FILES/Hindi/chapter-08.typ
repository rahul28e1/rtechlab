#mcq(num: 1, q: "आईपी 192.168.1.68 के लिए सिस्को राउटर कौन सा रूटिंग टेबल रूट चुनेगा?", a: "192.168.1.0/24 [1/0] via 10.1.1.1", b: "192.168.1.64/28 [110/20] via 10.2.2.2", c: "192.168.1.64/26 [90/3000] via 10.3.3.3", d: "0.0.0.0/0 [1/0] via 10.4.4.4", ans: "B", expl: "लॉन्गेस्ट प्रीफिक्स मैच के अनुसार सबसे लंबा मास्क (/28) अन्य सभी मास्कों की तुलना में सर्वोच्च वरीयता प्राप्त करता है।")
#mcq(num: 2, q: "फ्लोटिंग स्टैटिक रूट कॉन्फ़िगर करने का मुख्य उद्देश्य क्या है?", a: "असमान बैंडविड्थ पाथ्स पर लोड बैलेंसिंग", b: "एक स्वचालित बैकअप रूट प्रदान करना जो प्राइमरी रूट विफल होने पर सक्रिय हो", c: "BGP में डिफ़ॉल्ट रूट इंजेक्ट करना", d: "मल्टी-एरिया OSPF में लूप रोकना", ans: "B", expl: "फ्लोटिंग स्टैटिक रूट का AD प्राइमरी रूट से अधिक होता है, जिससे यह स्टैंडबाय बैकअप पाथ के रूप में कार्य करता है।")
#mcq(num: 3, q: "सर्वश्रेष्ठ पाथ निर्धारित करने हेतु OSPF कौन सा मीट्रिक एल्गोरिदम उपयोग करता है?", a: "हॉप काउंट", b: "बैंडविड्थ व डिले कंपोजिट", c: "लिंक बैंडविड्थ पर आधारित Dijkstra Shortest Path First (SPF) कॉस्ट", d: "पाथ वेक्टर AS-Path लंबाई", ans: "C", expl: "OSPF रेफरेंस बैंडविड्थ / इंटरफेस बैंडविड्थ के आधार पर Dijkstra एल्गोरिदम से संचयी पाथ कॉस्ट निकालता है।")
#mcq(num: 4, q: "router-id कमांड न दिए जाने पर सिस्को राउटर किस क्रम में OSPF RID चुनता है?", a: "फिजिकल इंटरफेस पर उच्चतम आईपी, फिर लूपबैक", b: "न्यूनतम मैक एड्रेस, फिर उच्चतम आईपी", c: "सक्रिय लूपबैक पर उच्चतम IPv4, फिर सक्रिय फिजिकल पर उच्चतम IPv4", d: "नेटवर्क स्टेटमेंट में कॉन्फ़िगर पहला आईपी", ans: "C", expl: "OSPF पहले मैन्युअल RID, फिर उच्चतम लूपबैक आईपी, और अंत में उच्चतम सक्रिय फिजिकल आईपी को वरीयता देता है।")
#mcq(num: 5, q: "ब्रॉडकास्ट ईथरनेट नेटवर्क पर दो OSPF DROther राउटर्स आपस में कौन सी स्थिति बनाए रखते हैं?", a: "Full", b: "2-Way", c: "Loading", d: "Attempt", ans: "B", expl: "DROther राउटर्स केवल DR और BDR के साथ Full आसन्नता बनाते हैं; आपस में वे 2-Way स्थिति में रहते हैं।")

