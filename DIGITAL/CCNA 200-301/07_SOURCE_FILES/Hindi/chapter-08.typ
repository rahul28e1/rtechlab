#short-q(num: 2, q: "सभी OSPF राउटर्स तक पहुंचने वाला IPv4 मल्टीकास्ट एड्रेस क्या है?", ans: "224.0.0.5।")
#short-q(num: 3, q: "सबनेट मास्क 255.255.255.240 (/28) के लिए वाइल्डकार्ड मास्क क्या है?", ans: "0.0.0.15 (255.255.255.255 - 255.255.255.240 = 0.0.0.15)।")
