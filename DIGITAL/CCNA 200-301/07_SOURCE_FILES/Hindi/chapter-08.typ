#mcq(num: 1, q: "192.168.1.68 पर जाने वाले पैकेट के लिए सिस्को राउटर कौन सा रूट चुनेगा?", a: "192.168.1.0/24 [1/0] via 10.1.1.1", b: "192.168.1.64/28 [110/20] via 10.2.2.2", c: "192.168.1.64/26 [90/3000] via 10.3.3.3", d: "0.0.0.0/0 [1/0] via 10.4.4.4", ans: "B", expl: "लॉन्गेस्ट प्रीफिक्स मैच नियम के तहत सबसे लंबा मास्क (/28) हमेशा जीतता है, चाहे AD कुछ भी हो।")
#mcq(num: 2, q: "फ्लोटिंग स्टैटिक रूट कॉन्फ़िगर करने का मुख्य उद्देश्य क्या है?", a: "असंतुलित लिंक पर लोड बैलेंसिंग", b: "एक स्वचालित बैकअप रूट प्रदान करना जो प्राथमिक रूट फेल होने पर ही सक्रिय होता है", c: "BGP में डिफॉल्ट रूट इंजेक्ट करना", d: "लूप रोकना", ans: "B", expl: "फ्लोटिंग स्टैटिक रूट का AD प्राथमिक प्रोटोकॉल से अधिक रखा जाता है ताकि यह बैकअप के रूप में काम करे।")
#mcq(num: 3, q: "OSPF गंतव्य नेटवर्क तक सर्वोत्तम पथ निर्धारित करने के लिए किस मीट्रिक का उपयोग करता है?", a: "हॉप काउंट", b: "बैंडविड्थ और डिले", c: "लिंक बैंडविड्थ पर आधारित डिज्क्स्ट्रा SPF कॉस्ट", d: "AS पाथ", ans: "C", expl: "OSPF लिंक बैंडविड्थ के आधार पर संचयी कॉस्ट निकालने के लिए डिज्क्स्ट्रा एल्गोरिदम चलाता है।")
#mcq(num: 4, q: "यदि मैन्युअल RID कॉन्फ़िगर न हो, तो सिस्को राउटर अपनी OSPF राउटर आईडी कैसे चुनता है?", a: "फिजिकल इंटरफेस, फिर लूपबैक", b: "न्यूनतम मैक एड्रेस", c: "सक्रिय लूपबैक पर उच्चतम IP, फिर सक्रिय फिजिकल पोर्ट पर उच्चतम IP", d: "पहला आईपी", ans: "C", expl: "OSPF पहले उच्चतम लूपबैक आईपी को वरीयता देता है, और फिर उच्चतम सक्रिय फिजिकल आईपी को।")
#mcq(num: 5, q: "मल्टी-एक्सेस ईथरनेट नेटवर्क पर दो DROther राउटर आपस में कौन सी अवस्था बनाए रखते हैं?", a: "Full", b: "2-Way", c: "Loading", d: "Attempt", ans: "B", expl: "DROther राउटर केवल DR और BDR के साथ Full बनते हैं; आपस में वे 2-Way अवस्था में रहते हैं।")

