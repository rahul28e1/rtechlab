  [`Down`], [पड़ोसी राउटर से कोई Hello पैकेट प्राप्त नहीं हुआ है।],
  [`Init`], [पड़ोसी से Hello मिला, परंतु स्थानीय Router-ID अभी पड़ोसी के Hello में नहीं है।],
  [`2-Way`], [द्वि-दिशीय संचार स्थापित (स्थानीय Router-ID पड़ोसी के Hello में दिखा)। मल्टी-एक्सेस लिंक पर DR/BDR चुनाव होता है। DROTHER राउटर्स आपस में 2-Way अवस्था में ही रहते हैं।],
  [`ExStart`], [डेटाबेस सिंक्रोनाइजेशन का पहला चरण। उच्चतम Router-ID के आधार पर Master/Slave संबंध और प्रारंभिक DBD सीक्वेंस नंबर तय होता है।],
  [`Exchange`], [राउटर्स अपनी LSDB के सारांश हेडर युक्त Database Description (DBD) पैकेट्स का आदान-प्रदान करते हैं।],
  [`Loading`], [राउटर्स Link State Request (LSR) द्वारा छूटी हुई जानकारी मांगते हैं, जिसका उत्तर Link State Update (LSU) द्वारा मिलता है।],
  [`Full`], [LSDBs पूरी तरह सिंक्रोनाइज हो चुकी हैं। नेबरशिप पूरी तरह सक्रिय है और रूट्स की गणना हो चुकी है।]
)

