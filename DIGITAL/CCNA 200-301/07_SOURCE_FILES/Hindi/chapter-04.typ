  [ग्लोबल यूनिकास्ट (GUA)], [`2000::/3`], [इंटरनेट पर सार्वजनिक रूप से रूटेबल एड्रेसेस। संरचना: /48 ग्लोबल रूटिंग प्रीफिक्स + /16 सबनेट ID + /64 इंटरफ़ेस ID।],
  [लिंक-लोकल (LLA)], [`fe80::/10`], [नॉन-रूटेबल अनिवार्य लोकल लिंक एड्रेसेस (`fe80::` से `febf::`)। राउटिंग प्रोटोकॉल पीयरिंग (OSPFv3) और डिफॉल्ट गेटवे हेतु प्रयुक्त।],
  [यूनिक लोकल (ULA)], [`fc00::/7` (`fd00::/8`)], [एंटरप्राइज इंट्रानेट के भीतर प्राइवेट रूटेबल एड्रेस (IPv4 RFC 1918 का समकक्ष)। इंटरनेट पर अप्रचलित।],
  [मल्टीकास्ट (Multicast)], [`ff00::/8`], [एक-से-अनेक संचार। `ff02::1` = All Nodes, `ff02::2` = All Routers, `ff02::5` = OSPFv3 Routers, `ff02::6` = OSPFv3 DR/BDR।],
  [लूपबैक (Loopback)], [`::1/128`], [आंतरिक परीक्षण एड्रेस (IPv4 `127.0.0.1` का समकक्ष)।],
  [अनस्पेसिफाइड (Unspecified)], [`::/128`], [आरंभीकरण के दौरान एड्रेस मिलने से पहले प्रयुक्त सोर्स एड्रेस।]
)

