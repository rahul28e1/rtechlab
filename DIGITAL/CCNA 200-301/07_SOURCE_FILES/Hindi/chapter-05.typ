  columns: (1.2fr, 1.2fr, 3.6fr),
  fill: (x, y) => if y == 0 { rgb("#E2E8F0") } else if calc.even(y) { rtech-paper } else { white },
  stroke: 0.5pt + rgb("#64748B"),
  inset: 3pt,
  table.header([*रजिस्टर मान*], [*बूट फील्ड बिट्स*], [*परिचालन व्यवहार एवं डायग्नोस्टिक उपयोग*]),
  [`0x2102`], [बिट 6 = 0, बिट्स 0-3 = 2], [सामान्य प्रोडक्शन परिचालन। फ्लैश से IOS लोड करता है और NVRAM से `startup-config` पढ़ता है। डिफ़ॉल्ट कंसोल 9600 बॉड।],
  [`0x2142`], [बिट 6 = 1 (0x0040)], [पासवर्ड रिकवरी बाईपास। बूट के समय NVRAM के `startup-config` को अनदेखा करता है, जिससे पासवर्ड सुरक्षित रहते हुए सेटअप मोड खुलता है।],
  [`0x2100`], [बिट्स 0-3 = 0], [डायग्नोस्टिक मोड। सीधे ROMMON प्रॉम्प्ट (`rommon 1 >`) में बूट होता है।],
  [`0x2101`], [बिट्स 0-3 = 1], [TFTP इमरजेंसी री-फ्लैशिंग हेतु ROM में स्थित मिनी-IOS (RxBoot) से बूट करता है।]
)

