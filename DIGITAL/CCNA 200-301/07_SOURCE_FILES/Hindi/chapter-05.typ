#text(size: 7.5pt, weight: "bold", fill: rtech-navy)[2. लघु-उत्तरीय समीक्षा प्रश्न]
#short-q(num: 1, q: "सक्रिय running-config किस मेमोरी में रहती है?", ans: "RAM (Random Access Memory).")
#short-q(num: 2, q: "सामान्य बूट हेतु मानक हेक्साडेसिमल कॉन्फ़िगरेशन रजिस्टर मान क्या है?", ans: "0x2102.")
#short-q(num: 3, q: "बूट के समय NVRAM नजरअंदाज करने वाला रजिस्टर मान क्या है?", ans: "0x2142.")
#short-q(num: 4, q: "कैटलिस्ट स्विच में स्थायी कॉन्फ़िग फ्लैश में किस नाम से रहती है?", ans: "config.text.")
#short-q(num: 5, q: "पावर ऑन होते ही प्रारंभिक हार्डवेयर जांच करने वाला प्रोग्राम कौन सा है?", ans: "Power-On Self-Test (POST).")

#v(2pt)
#text(size: 7.5pt, weight: "bold", fill: rtech-navy)[3. 5 उच्च-अंक बहुविकल्पीय प्रश्न (MCQs)]
#mcq(num: 1, q: "बिजली चले जाने पर सिस्को राउटर का कौन सा मेमोरी घटक डेटा सुरक्षित रखता है?", a: "RAM", b: "DRAM", c: "NVRAM", d: "SRAM", ans: "C", expl: "NVRAM पावर कटने पर भी startup-config और रजिस्टर मान को सुरक्षित रखती है।")
#mcq(num: 2, q: "राउटर को सामान्य प्रोडक्शन बूट पर लौटाने वाली सही कमांड कौन सी है?", a: "boot system flash", b: "config-register 0x2102", c: "confreg 0x2142", d: "register reset default", ans: "B", expl: "config-register 0x2102 ग्लोबल कॉन्फ़िगरेशन मोड से सामान्य बूट रीस्टोर करती है।")
#mcq(num: 3, q: "पासवर्ड रिकवरी के दौरान copy startup-config running-config चलाना क्यों अनिवार्य है?", a: "इनेबल पासवर्ड मिटाने हेतु", b: "मौजूदा प्रोडक्शन सेटिंग्स को मिटाए बिना रैम में लोड करने हेतु", c: "फ्लैश इनिशियलाइज़ करने हेतु", d: "SSH v2 चालू करने हेतु", ans: "B", expl: "रैम में स्टार्टअप कॉन्फ़िग लोड करने से पूर्व की सेटिंग्स सुरक्षित रहती हैं और ओवरराइट नहीं होतीं।")
#mcq(num: 4, q: "कैटलिस्ट स्विच में पासवर्ड रिकवरी ट्रिगर करने हेतु कौन सा हार्डवेयर बटन दबाया जाता है?", a: "Reset पिनहोल", b: "Mode Button", c: "कंसोल स्विच", d: "RPS टॉगल", ans: "B", expl: "फ्रंट पैनल का Mode Button दबाकर पावर ऑन करने से स्विच 'switch:' बूटलोडर पर आ जाता है।")
#mcq(num: 5, q: "सिस्को IOS में सक्रिय कॉन्फ़िगरेशन रजिस्टर मान देखने वाली कमांड कौन सी है?", a: "show boot", b: "show running-config", c: "show version", d: "show registers", ans: "C", expl: "show version आउटपुट के सबसे अंत में सक्रिय Configuration register मान दिखाती है।")

